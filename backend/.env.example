# --- Database ---
# Local dev (MySQL: localhost:3306, user root, password root, db crm_system):
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/crm_system
# Docker / production example:
DATABASE_URL=mysql+pymysql://crm_user:change_me_strong_password@db:3306/crm_system
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=crm_system
MYSQL_USER=crm_user
MYSQL_PASSWORD=change_me_strong_password

# --- WooCommerce Webhooks ---
WC_WEBHOOK_SECRET=change_me_webhook_secret_min_32_chars
# Set to true ONLY for local mock testing if you don't want to sign requests.
# Keep false in production.
WEBHOOK_SKIP_SIGNATURE=false

# --- WooCommerce REST API (server-side only; never expose to frontend) ---
# Leave empty to run in demo mode with sample data.
WC_STORE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- Auth / sessions ---
# Cookie is Secure+SameSite=None in production, plain Lax on localhost (auto).
SESSION_COOKIE_NAME=kk_session
SESSION_EXPIRE_DAYS=30
SESSION_INACTIVITY_DAYS=7
# Public URL of the frontend (used in password-reset emails).
FRONTEND_URL=http://localhost:5173
# Auth rate limit: attempts per window per IP.
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_S=600

# --- App ---
APP_NAME=WooCommerce CRM Backend
ENVIRONMENT=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# --- Email (SMTP) ---
# If SMTP_HOST is empty, emails are logged to stdout + DB (safe dev default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=WooCommerce CRM
SMTP_USE_TLS=true
