# --- Database (local MySQL: user root / password root) ---
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/woocommerce_crm
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=woocommerce_crm
MYSQL_USER=root
MYSQL_PASSWORD=root

# --- WooCommerce Webhooks ---
WC_WEBHOOK_SECRET=QjpWkayzjfGNzTiZ43P2On7Vsd04trzK7fLjNpfGihI
# --- WooCommerce REST API (live sync; leave empty for demo mode) ---
# WC_STORE_URL=https://your-store.com
# WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxx
# WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxx
# Set to true ONLY for local mock testing if you don't want to sign requests.
# Keep false in production.
WEBHOOK_SKIP_SIGNATURE=false

# --- App ---
APP_NAME=WooCommerce CRM Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# --- Email (SMTP) ---
# If SMTP_HOST is empty, emails are logged to stdout + DB (safe dev default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=WooCommerce CRM
SMTP_USE_TLS=true
