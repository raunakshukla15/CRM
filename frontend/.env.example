# Points at the FastAPI backend (note the /api/v1 prefix).
# IMPORTANT: use the SAME host you open the site with (localhost, not 127.0.0.1).
# The session cookie is SameSite=Lax, so the browser only sends it when page
# and API share the same host. Always open http://localhost:5173 (and restart
# `npm run dev` after changing this file — Vite reads it at startup).
VITE_API_URL=http://localhost:8000/api/v1
